# Copy this file to "server/.env" and fill in your own values.
# The real .env is never pushed to GitHub (it's in .gitignore).

# Port for the local API (not used on Vercel)
PORT=5000

# MongoDB Atlas connection string. Put the database name before the "?".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chief-rice-trader?retryWrites=true&w=majority&appName=ChiefRice

# Long random string used to sign logins. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Only needed the first time you run "npm run seed" on an empty database,
# to create the two logins. Change them later from the login screen.
SEED_ADMIN_PASSWORD=
SEED_SALESMAN_PASSWORD=
